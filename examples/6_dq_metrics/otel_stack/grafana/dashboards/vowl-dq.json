{
  "uid": "vowl-dq",
  "title": "vowl DQ metrics",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service.name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(vowl_run_check_pass_rate_ratio, service_name)",
          "refId": "service"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "domain",
        "label": "domain",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(vowl_run_check_pass_rate_ratio{service_name=~\"$service\"}, vowl_domain)",
          "refId": "domain"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "contract",
        "label": "contract",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(vowl_run_check_pass_rate_ratio{service_name=~\"$service\", vowl_domain=~\"$domain\"}, vowl_contract_name)",
          "refId": "contract"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Contracts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (vowl_contract_name) (last_over_time(vowl_run_check_pass_rate_ratio{service_name=~\"$service\", vowl_domain=~\"$domain\", vowl_contract_name=~\"$contract\"}[$__range])))",
          "legendFormat": "",
          "instant": false,
          "range": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8ea8c3",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Contracts with failing checks",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (vowl_contract_name) (last_over_time(vowl_run_check_pass_rate_ratio{service_name=~\"$service\", vowl_domain=~\"$domain\", vowl_contract_name=~\"$contract\"}[$__range])) < 1) or vector(0)",
          "legendFormat": "",
          "instant": false,
          "range": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6baf7b",
                "value": null
              },
              {
                "color": "#d16d6d",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Catalog check pass rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(last_over_time(vowl_run_check_count_total{service_name=~\"$service\", vowl_domain=~\"$domain\", vowl_contract_name=~\"$contract\", status=\"PASSED\"}[$__range])) / sum(last_over_time(vowl_run_check_count_total{service_name=~\"$service\", vowl_domain=~\"$domain\", vowl_contract_name=~\"$contract\"}[$__range]))",
          "legendFormat": "",
          "instant": false,
          "range": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d16d6d",
                "value": null
              },
              {
                "color": "#d9a54a",
                "value": 0.9
              },
              {
                "color": "#6baf7b",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
