      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "spans",
          "spss": 20,
          "query": "{ name = \"vowl.validate\" && span.row.approximate = true && resource.service.name =~ \"${service:regex}\" && resource.vowl.domain =~ \"${domain:regex}\" && resource.vowl.contract.name =~ \"${contract:regex}\" } > { name = \"vowl.check\" && (span.row.approximate = true || span.status = \"ERROR\") } | select(resource.vowl.contract.name, span.schema_name, span.check_name, span.status, span.row.attribution_note)"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Last seen",
            "desc": true
          }
        ]
