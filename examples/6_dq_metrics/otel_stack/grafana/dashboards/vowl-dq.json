        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max by (vowl_contract_name) (last_over_time(vowl_run_row_count{service_name=~\"$service\", vowl_domain=~\"$domain\", vowl_contract_name=~\"$contract\", status=\"FAILED\"}[$__range])))",
          "legendFormat": "",
          "instant": false,
          "range": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6baf7b",
                "value": null
              },
              {
                "color": "#d16d6d",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Failed rows of each contract's latest run, summed. Attributed rows: the table rows that failed at least one row-level check, every copy counted. Exact unless marked approximate. See [Approximate row counts](https://github.com/govtech-data-practice/vowl/blob/main/docs/dq-metrics/understanding-metrics.md#approximate-row-counts)."
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Row numbers",
      "description": "Whether the row numbers of each contract's latest run are exact. When some are approximate, the table **Approximate row numbers: which checks and why** near the bottom says which check caused it and why. See [Approximate row counts](https://github.com/govtech-data-practice/vowl/blob/main/docs/dq-metrics/understanding-metrics.md#approximate-row-counts).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "",
          "expr": "count(max by (vowl_contract_name) (last_over_time(vowl_run_row_approximate_ratio{service_name=~\"$service\", vowl_domain=~\"$domain\", vowl_contract_name=~\"$contract\"}[$__range])) == 1) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6baf7b",
                "value": null
              },
              {
                "color": "#d9a54a",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "All exact",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1,
                "result": {
                  "text": "1 contract approximate",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 2,
                "to": null,
                "result": {
                  "text": "${__value.raw} contracts approximate",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
